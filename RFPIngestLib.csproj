<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Library</OutputType>
    <RootNamespace>RFPIngestLib</RootNamespace>
    <AssemblyName>RFPIngestLib</AssemblyName>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Interfaces/**/*.cs;Implementations/**/*.cs;Structures/**/*.cs;Extractors/**/*.cs;Storage/**/*.cs" />
    <EmbeddedResource Include="Resources/icon.png" LogicalName="RFPIngestLib.Resources.icon.png" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="OutSystems.ExternalLibraries.SDK" Version="1.7.0" />
    <PackageReference Include="AWSSDK.S3" Version="4.0.104.1" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="SixLabors.Fonts" Version="[1.0.0,2.0.0)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
  </ItemGroup>
</Project>
